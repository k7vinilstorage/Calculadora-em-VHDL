*.bgn
*.bld
*.cmd_log
*.drc
*.ll
*.lso
*.msd
*.msk
*.ncd
*.ngc
*.ngd
*.ngr
*.pad
*.par
*.pcf
*.prj
*.ptwx
*.rbb
*.rbd
*.stx
*.syr
*.twr
*.twx
*.unroutes
*.ut
*.xpi
*.xst
*.xwbt
*.xrpt
*.xdl
*.schlog
*.vf
*.vhf
*.jhd
*_map.*
*_pad.*
*.csv
sch2HdlBatchFile

# Report and log files
*.html
*.xml
*.log
*.tcl
*.debug

# Project runtime / session state
*.gise

# Generated directories
iseconfig/
xlnx_auto_0_xdb/
xst/
_ngo/
_xmsgs/
.Xil/
planAhead_run_*/
ipcore_dir/

# Keep bitstreams (.bit) for direct FPGA programming
!*.bit
